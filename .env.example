# Lost Ark API Key
# 발급처: https://developer.neople.co.kr/
# 마켓 API 접근 권한 필요
LOSTARK_API_KEY=your_api_key_here

# Upstash Redis URL
# 발급처: https://upstash.com/
# Redis database의 UPSTASH_REDIS_URL 값
UPSTASH_REDIS_URL=redis://default:your_password@your-region-endpoint.upstash.io:port

# Upstash Redis Token
# 발급처: https://upstash.com/
# Redis database의 UPSTASH_REDIS_TOKEN 값
UPSTASH_REDIS_TOKEN=your_token_here
